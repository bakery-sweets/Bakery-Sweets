# ==============================================================================
# Biến môi trường cho docker-compose.yml
# Sao chép thành .env (đã ignore trên git) rồi điền giá trị thật:  cp .env.example .env
# Sinh khóa ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==============================================================================

# MariaDB (chỉ áp dụng khi tạo volume db_data lần đầu; đổi sau đó phải ALTER USER trong DB)
DB_ROOT_PASSWORD=change-me-root
DB_NAME=thesweets_db
DB_USER=user
DB_PASSWORD=change-me

# Khóa ký JWT, dùng chung cho web_backend, mobile_backend và realtime
SECRET_KEY=change-me-random-64-chars
# Khóa để 2 backend gửi sự kiện sang realtime qua /internal/events
INTERNAL_API_KEY=change-me-random-32-chars
